{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The session layer for DreamDEX Event Contracts on Somnia: your winnings come to you.",
  "keywords": [
    "somnia",
    "dreamdex",
    "event-contracts",
    "prediction-markets",
    "nextjs",
    "solidity",
    "wagmi",
    "viem"
  ],
  "author": "Pulse Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Olorunshogo/Pulse.git"
  },
  "bugs": {
    "url": "https://github.com/Olorunshogo/Pulse/issues"
  },
  "homepage": "https://github.com/Olorunshogo/Pulse#readme",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:contracts && npm run test:client",
    "test:client": "vitest run",
    "test:contracts": "forge test",
    "deploy:test": "forge script scripts/DeployPulseSessionFactory.s.sol --rpc-url \"$NEXT_PUBLIC_RPC_URL\" --broadcast --verify"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "^0.29.0",
    "@somnia-chain/reactivity": "^0.2.1",
    "@tanstack/react-query": "^5.102.8",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.2",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
